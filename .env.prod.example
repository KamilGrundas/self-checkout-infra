# Secret-free production shape. Supply actual values through the deployment
# secret manager; do not use this file as credentials.
PROJECT_NAME="Self Checkout Backend"
FRONTEND_HOST=https://checkout.example.invalid
BACKEND_PUBLIC_URL=https://api.example.invalid
VITE_API_URL=https://api.example.invalid
VITE_ML_API_URL=https://ml.example.invalid
ENVIRONMENT=production
BACKEND_CORS_ORIGINS=https://checkout.example.invalid
SECRET_KEY=<required-secret>
FIRST_SUPERUSER=admin@example.invalid
FIRST_SUPERUSER_PASSWORD=<required-secret>
DATABASE_URL=postgresql+psycopg://<user>:<password>@<external-postgres>:5432/<database>?sslmode=require&connect_timeout=10
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
S3_ENDPOINT_URL=https://s3.example.invalid
S3_REGION=us-east-1
S3_BUCKET=product-images
S3_ACCESS_KEY_ID=<provided-by-secret-manager-or-empty-for-role-auth>
S3_SECRET_ACCESS_KEY=<provided-by-secret-manager-or-empty-for-role-auth>
S3_SESSION_TOKEN=
S3_USE_SSL=true
S3_FORCE_PATH_STYLE=false
S3_VERIFY_TLS=true
S3_CONNECT_TIMEOUT=5
S3_READ_TIMEOUT=30
S3_MAX_RETRIES=3
S3_CREATE_BUCKETS=false
S3_PUBLIC_BASE_URL=https://objects.example.invalid
S3_SHELF_BUCKET=session-images
S3_SCALE_BUCKET=scale-images
S3_EXTERNAL_BUCKET=uploaded-images
S3_TRAINING_BUCKET=training-data
S3_LABEL_STUDIO_EXPORT_BUCKET=labelstudio-exports
MLFLOW_TRACKING_URI=
MLFLOW_REGISTERED_MODEL_NAME=self-checkout-classifier
MLFLOW_SHELF_EXPERIMENT_NAME=self-checkout-shelf-classifier
MLFLOW_SHELF_MODEL_NAME=self-checkout-shelf-classifier
MODEL_CACHE_DIR=.cache/model_store
LABEL_STUDIO_URL=
LABEL_STUDIO_API_KEY=
DOCKER_IMAGE_BACKEND=registry.example.invalid/backend
DOCKER_IMAGE_ADMIN=registry.example.invalid/admin
DOCKER_IMAGE_ML=registry.example.invalid/ml
TAG=<approved-immutable-release>

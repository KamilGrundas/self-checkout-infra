# Development template. Copy to .env on dev only; never commit the resulting file.
PROJECT_NAME="Self Checkout Backend"
FRONTEND_HOST=http://localhost:5173
VITE_API_URL=http://localhost:8000
# Optional input for scripts/repair-dev-env.sh, for example 192.0.2.10.
DEV_PUBLIC_HOST=
ENVIRONMENT=local
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173,https://localhost,https://localhost:5173

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=true
SMTP_SSL=false
SMTP_PORT=587
SENTRY_DSN=

POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Point this at an external S3-compatible endpoint or use an untracked provider
# overlay based on compose.s3-provider.example.yml.
S3_ENDPOINT_URL=http://s3-provider:8080
S3_REGION=us-east-1
S3_BUCKET=product-images
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key
S3_SESSION_TOKEN=
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
S3_VERIFY_TLS=true
S3_CONNECT_TIMEOUT=5
S3_READ_TIMEOUT=30
S3_MAX_RETRIES=3
S3_CREATE_BUCKETS=true
S3_PUBLIC_BASE_URL=http://localhost:8082
S3_SHELF_BUCKET=session-images
S3_SCALE_BUCKET=scale-images
S3_EXTERNAL_BUCKET=uploaded-images
S3_TRAINING_BUCKET=training-data
S3_LABEL_STUDIO_EXPORT_BUCKET=labelstudio-exports

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=sqlite:////mlflow/mlflow.db
MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts
MLFLOW_SERVER_ALLOWED_HOSTS=mlflow:5000,localhost:5000,localhost:5002,127.0.0.1:5000,127.0.0.1:5002
MLFLOW_REGISTERED_MODEL_NAME=self-checkout-classifier
MLFLOW_SHELF_EXPERIMENT_NAME=self-checkout-shelf-classifier
MLFLOW_SHELF_MODEL_NAME=self-checkout-shelf-classifier
MODEL_CACHE_DIR=.cache/model_store
LABEL_STUDIO_URL=http://label-studio:8080
LABEL_STUDIO_USERNAME=admin@example.com
LABEL_STUDIO_PASSWORD=changethis
LABEL_STUDIO_API_KEY=changethis-api-key
LABEL_STUDIO_SCALE_PROJECT_TITLE=scale-products
LABEL_STUDIO_SHELF_PROJECT_TITLE=shelf-products
LABEL_STUDIO_EXTERNAL_PROJECT_TITLE=external-products

DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_ADMIN=admin
DOCKER_IMAGE_ML=ml
TAG=dev

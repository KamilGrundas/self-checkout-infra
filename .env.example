# Development template. Copy to .env on dev only; never commit the resulting file.
PROJECT_NAME="Self Checkout Backend"
FRONTEND_HOST=https://dev.admin.teik.pl
BACKEND_PUBLIC_URL=https://dev.api.teik.pl
VITE_API_URL=https://dev.api.teik.pl
VITE_ML_API_URL=https://dev.ml.teik.pl
ENVIRONMENT=local
BACKEND_CORS_ORIGINS=https://dev.admin.teik.pl

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=true
SMTP_SSL=false
SMTP_PORT=587
SENTRY_DSN=

POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Point this at an external S3-compatible endpoint or use an untracked provider
# overlay based on compose.s3-provider.example.yml.
S3_ENDPOINT_URL=http://s3-provider:8080
S3_REGION=us-east-1
S3_BUCKET=product-images
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key
S3_SESSION_TOKEN=
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
S3_VERIFY_TLS=true
S3_CONNECT_TIMEOUT=5
S3_READ_TIMEOUT=30
S3_MAX_RETRIES=3
S3_CREATE_BUCKETS=true
# Browser-facing S3 API endpoint. This is distinct from the provider console.
S3_PUBLIC_BASE_URL=https://dev.s3-api.teik.pl
S3_SHELF_BUCKET=session-images
S3_SCALE_BUCKET=scale-images
S3_EXTERNAL_BUCKET=uploaded-images
S3_TRAINING_BUCKET=training-data
TRAINING_QUEUE_URL=redis://redis:6379/0

DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_ADMIN=admin
DOCKER_IMAGE_ML=ml
TAG=dev

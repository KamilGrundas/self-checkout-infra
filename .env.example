# Safe portable development example. Copy into a local ignored environment.
PROJECT_NAME="Self Checkout Backend"
FRONTEND_HOST=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
VITE_ML_API_URL=http://localhost:8001
ENVIRONMENT=local
BACKEND_CORS_ORIGINS=http://localhost:5173

# Choose local authentication or configure generic OIDC values locally.
AUTH_MODE=local
OIDC_ISSUER=https://identity.example.test/application/o/self-checkout/
OIDC_CLIENT_ID=replace-with-public-client-id
OIDC_BUTTON_LABEL=Single sign-on
OIDC_USER_GROUP=self-checkout-users
OIDC_ADMIN_GROUP=self-checkout-admins
API_KEYS_ENABLED=true
LOCAL_SIGNUP_ENABLED=false

SECRET_KEY=replace-with-random-secret
FIRST_SUPERUSER=admin@sample.org
FIRST_SUPERUSER_PASSWORD=replace-with-random-secret

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@sample.org
SMTP_TLS=true
SMTP_SSL=false
SMTP_PORT=587
SENTRY_DSN=

POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-random-secret
DATABASE_URL=
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# External S3-compatible endpoint or a local provider overlay.
S3_ENDPOINT_URL=http://s3-provider:8080
S3_REGION=us-east-1
S3_BUCKET=product-images
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=replace-with-random-secret
S3_SESSION_TOKEN=
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
S3_VERIFY_TLS=true
S3_CONNECT_TIMEOUT=5
S3_READ_TIMEOUT=30
S3_MAX_RETRIES=3
S3_CREATE_BUCKETS=true
S3_PUBLIC_BASE_URL=http://localhost:8082
S3_SHELF_BUCKET=session-images
S3_SCALE_BUCKET=scale-images
S3_EXTERNAL_BUCKET=uploaded-images
S3_TRAINING_BUCKET=training-data
TRAINING_QUEUE_URL=redis://redis:6379/0

DOCKER_IMAGE_BACKEND=self-checkout-backend
DOCKER_IMAGE_ADMIN=self-checkout-admin
DOCKER_IMAGE_ML=self-checkout-ml
TAG=dev
